#include <iostream>
#include <vector>
 
using namespace std;
 
int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
 
    int n, h;
    if (!(cin >> n >> h)) return 0;
 
    // dp[i][j] represents the number of BSTs with 'i' nodes and height <= 'j'
    // Constraints: n <= 35, so 40 is a safe upper bound.
    long long dp[40][40] = {0};
 
    // Base case: A tree with 0 nodes has a height of 0.
    for (int j = 0; j <= n; ++j) {
        dp[0][j] = 1;
    }
 
    // Fill the DP table
    for (int i = 1; i <= n; ++i) {          // Number of nodes
        for (int j = 1; j <= n; ++j) {      // Maximum allowed height
            dp[i][j] = 0;
            for (int root = 1; root <= i; ++root) {
                int left_nodes = root - 1;
                int right_nodes = i - root;
                dp[i][j] += dp[left_nodes][j - 1] * dp[right_nodes][j - 1];
            }
        }
    }
 
    // Trees with height >= h is (trees with height <= n) - (trees with height <= h - 1)
    long long ans = dp[n][n] - dp[n][h - 1];
 
    cout << ans << "
";
 
    return 0;
}